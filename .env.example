# Los teléfonos del seed son placeholders y no reciben WhatsApp (ver INC-01 del
# spec: las fuentes no traen el teléfono de los usuarios). Solo para desarrollo.
#
# Con SEED_OTP_PHONE a solas, tu número se aplica a los 10 usuarios del seed:
# así se prueban los distintos roles cerrando sesión y entrando con otro correo.
# Agregar SEED_OTP_EMAIL lo limita a ese usuario.
SEED_OTP_PHONE=""
SEED_OTP_EMAIL=""
